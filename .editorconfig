root = true

[*.{cs,csx}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

# C# formatting and analyzer defaults are shared by the SDK and dotnet format.
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_new_line_before_open_brace = all
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_using_directive_placement = outside_namespace

# Analyzer severities stay at SDK defaults unless the team explicitly promotes a rule.

# Preserve the existing line endings and encoding for these legacy files.
[/Program.cs]
charset = utf-8-bom
end_of_line = crlf

[/ViewModels/MainViewModel.cs]
end_of_line = crlf

[/ViewModels/ViewModelBase.cs]
charset = utf-8-bom
end_of_line = crlf
