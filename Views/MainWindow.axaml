<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tatami.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:io="using:System.IO"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
        x:Class="Tatami.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Tatami">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
        to set the actual DataContext for runtime, set the DataContext property in code (look at
        App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>
    <StackPanel Background="Lavender">
        <Button HorizontalAlignment="Center" Click="GetFiles">フォルダを選択</Button>
        <ListBox Name="Folder_Contents"
                 SelectionMode="Single"
                 SelectionChanged="File_Selected">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="io:FileInfo">
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBox Name="content"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="Wrap" />
    </StackPanel>
</Window>