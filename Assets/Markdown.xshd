<SyntaxDefinition name="Markdown" extensions=".md" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Heading" foreground="#82C6AF" fontWeight="bold" />
  <Color name="Code" foreground="#D9B780" />
  <Color name="Quote" foreground="#8792A7" fontStyle="italic" />
  <Color name="Link" foreground="#8DBAF0" />
  <Color name="Strong" foreground="#DFD1F1" fontWeight="bold" />
  <RuleSet>
    <Span color="Code" begin="^```" end="^```" multiline="true" />
    <Rule color="Heading">^\#{1,6}\s.*$</Rule>
    <Rule color="Quote">^\s*&gt;.*$</Rule>
    <Span color="Code" begin="`" end="`" />
    <Rule color="Strong">\*\*[^*]+\*\*</Rule>
    <Rule color="Link">\[[^\]]+\]\([^)]+\)</Rule>
  </RuleSet>
</SyntaxDefinition>
