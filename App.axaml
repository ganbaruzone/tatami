<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Tatami.App"
             xmlns:local="using:Tatami"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
        <Style Selector="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#454B58" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#30343E" />
            <Setter Property="BorderBrush" Value="#667184" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#39404B" />
            <Setter Property="BorderBrush" Value="#82C6AF" />
        </Style>
        <Style Selector="Button:focus">
            <Setter Property="BorderBrush" Value="#82C6AF" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="BorderBrush" Value="#30333B" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="BorderBrush" Value="#454B58" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox:pointerover">
            <Setter Property="BorderBrush" Value="#667184" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#82C6AF" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="BorderBrush" Value="#454B58" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ComboBox:pointerover">
            <Setter Property="BorderBrush" Value="#667184" />
        </Style>
        <Style Selector="ComboBox:focus">
            <Setter Property="BorderBrush" Value="#82C6AF" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="BorderBrush" Value="#30343E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="ComboBoxItem:pointerover">
            <Setter Property="Background" Value="#2A2D35" />
            <Setter Property="BorderBrush" Value="#667184" />
        </Style>
        <Style Selector="ComboBoxItem:selected">
            <Setter Property="Background" Value="#263C56" />
            <Setter Property="BorderBrush" Value="#4D8DCC" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="BorderBrush" Value="#30343E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#2A2D35" />
            <Setter Property="BorderBrush" Value="#667184" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#263C56" />
            <Setter Property="BorderBrush" Value="#4D8DCC" />
        </Style>
        <Style Selector="ListBoxItem:focus">
            <Setter Property="BorderBrush" Value="#82C6AF" />
        </Style>

        <Style Selector="TreeViewItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#30343E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style Selector="TreeViewItem:pointerover">
            <Setter Property="Background" Value="#2A2D35" />
            <Setter Property="BorderBrush" Value="#667184" />
        </Style>
        <Style Selector="TreeViewItem:selected">
            <Setter Property="Background" Value="#263C56" />
            <Setter Property="BorderBrush" Value="#4D8DCC" />
        </Style>
        <Style Selector="TreeViewItem:focus">
            <Setter Property="BorderBrush" Value="#82C6AF" />
        </Style>
    </Application.Styles>
</Application>
