<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Tatami.CommandLine</AssemblyName>
    <PackageId>Tatami.CommandLine</PackageId>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Tatami.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Tatami.Tests" />
  </ItemGroup>
  <Target Name="CreateTatamiCommandName" AfterTargets="Publish" Condition="Exists('$(PublishDir)$(AssemblyName)')">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName)" DestinationFiles="$(PublishDir)tatami" />
  </Target>
</Project>
