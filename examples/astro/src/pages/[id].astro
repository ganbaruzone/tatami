---
import { getCollection, render } from 'astro:content';
import '../styles/site.css';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map(note => ({ params: { id: note.data.slug ?? note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content } = await render(note);
const title = note.data.title ?? note.id;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; img-src 'self' https:; base-uri 'none'; form-action 'none'" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <p class="brand">TATAMI / ASTRO</p>
      <h1>{title}</h1>
      {note.data.date && <time>{note.data.date.toISOString().slice(0, 10)}</time>}
      <article><Content /></article>
      <footer>Markdownで書く。Astroで公開する。</footer>
    </main>
  </body>
</html>
